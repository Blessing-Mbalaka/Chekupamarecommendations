# Django
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-for-production
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_EMBED_MODEL=gemini-embedding-2

# Ollama local fallback
OLLAMA_BASE_URL=http://localhost:11434/api
OLLAMA_TEXT_MODEL=ministral-3:3b
OLLAMA_EMBED_MODEL=nomic-embed-text:latest

# External academic providers
# OpenAlex requires a free API key for API usage in current docs.
OPENALEX_API_KEY=
OPENALEX_EMAIL=you@example.com
OPENALEX_BASE_URL=https://api.openalex.org
OPENALEX_CONTENT_BASE_URL=https://content.openalex.org
OPENALEX_ENABLE_PDF_DOWNLOADS=True
OPENALEX_PDF_DAILY_BUDGET=100
OPENALEX_PREFERRED_LICENSE=cc-by

# Crossref is free and does not typically require a key.
CROSSREF_MAILTO=you@example.com

# Semantic Scholar may work without a key for light usage,
# but add one here if you have it for better reliability.
SEMANTIC_SCHOLAR_API_KEY=

# Future providers
# YouTube API key is needed for Data API search/metadata calls,
# but not for simple iframe embeds when you already have a video URL.
YOUTUBE_API_KEY=
SCOPUS_API_KEY=
