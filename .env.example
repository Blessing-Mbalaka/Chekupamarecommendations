# Django
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=generate-a-long-random-value-never-commit-it
DJANGO_ALLOWED_HOSTS=example.edu,www.example.edu
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.edu,https://www.example.edu
DJANGO_SECURE_COOKIES=True
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=31536000
DJANGO_CACHE_BACKEND=django.core.cache.backends.filebased.FileBasedCache
DJANGO_CACHE_LOCATION=/srv/recommendation-engine/shared/cache

# PostgreSQL (recommended on the VPS; never commit the real password)
DB_ENGINE=postgresql
DB_NAME=recommendation_engine
DB_USER=recommendation_engine
DB_PASSWORD=replace-on-the-server
DB_HOST=127.0.0.1
DB_PORT=5432

# SMTP account invitations/password resets. Emails contain links, never passwords.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.edu
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@example.edu
EMAIL_HOST_PASSWORD=replace-on-the-server
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Course Support <no-reply@example.edu>

# Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_EMBED_MODEL=gemini-embedding-2
GEMINI_TEXT_TIMEOUT_SECONDS=3
GEMINI_EMBED_TIMEOUT_SECONDS=2

# Ollama local fallback
OLLAMA_BASE_URL=http://localhost:11434/api
OLLAMA_TEXT_MODEL=ministral-3:3b
OLLAMA_FAST_TEXT_MODEL=tinyllama:latest
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
OLLAMA_TAGS_TIMEOUT_SECONDS=1
OLLAMA_TEXT_TIMEOUT_SECONDS=180
OLLAMA_EMBED_TIMEOUT_SECONDS=2
OLLAMA_MODELS_TTL_SECONDS=15
OLLAMA_TEMPERATURE=0.2
OLLAMA_TOP_P=0.9
OLLAMA_TOP_K=40
OLLAMA_REPEAT_PENALTY=1.1
OLLAMA_NUM_PREDICT=500

# External academic providers
# OpenAlex requires a free API key for API usage in current docs.
OPENALEX_API_KEY=
OPENALEX_EMAIL=you@example.com
OPENALEX_BASE_URL=https://api.openalex.org
OPENALEX_CONTENT_BASE_URL=https://content.openalex.org
OPENALEX_ENABLE_PDF_DOWNLOADS=True
OPENALEX_PDF_DAILY_BUDGET=100
OPENALEX_PREFERRED_LICENSE=cc-by
PROVIDER_REQUEST_TIMEOUT_SECONDS=2.5
PROVIDER_DISCOVERY_BUDGET_SECONDS=5

# Crossref is free and does not typically require a key.
CROSSREF_MAILTO=you@example.com

# Semantic Scholar may work without a key for light usage,
# but add one here if you have it for better reliability.
SEMANTIC_SCHOLAR_API_KEY=

# Springer Nature
SPRINGER_API_KEY=
SPRINGER_API_BASE_URL=https://api.springernature.com
SPRINGER_META_ENDPOINT=/meta/v2/json
SPRINGER_OPENACCESS_ENDPOINT=/openaccess/json
SPRINGER_METADATA_ENDPOINT=/metadata/json
SPRINGER_FULLTEXT_ENDPOINT=/xmldata/jats

# SerpApi Google Scholar
SERPAPI_API_KEY=
SERPAPI_BASE_URL=https://serpapi.com/search
SERPAPI_SCHOLAR_RESULTS=10

# YouTube
# This app treats YouTube as manual-only. Lecturers/admins paste known URLs to embed.
SCOPUS_API_KEY=
